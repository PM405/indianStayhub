 <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
  <div class="container">

    <!-- Logo -->
    <a class="navbar-brand fw-bold text-primary" href="/listings">
      <i class="fa-regular fa-compass"></i> IndiaStayHub
    </a>

    <!-- Toggle -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar Content -->
    <div class="collapse navbar-collapse" id="navbarNav">

      <% if(currentUser) { %>

        <!-- Search Bar -->
        <form
          class="d-flex mx-lg-4 my-3 my-lg-0"
          action="/listings/search"
          method="GET">

          <input
            class="form-control"
            type="search"
            name="q"
            placeholder="Search Goa, Manali, Jaipur..."
            aria-label="Search">

          <button class="btn btn-primary ms-2" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>

        </form>

      <% } %>


      <!-- Right Side Links -->
      <ul class="navbar-nav ms-auto align-items-lg-center text-center">

        <!-- Home -->
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="/listings">
            Home
          </a>
        </li>

        <!-- My Bookings -->
        <% if(currentUser) { %>

          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/mybookings">
              My Bookings
            </a>
          </li>

          <!-- Username -->
          <li class="nav-item">
            <span class="nav-link fw-semibold text-success">
              <i class="fa-solid fa-user"></i>
              <%= currentUser.username %>
            </span>
          </li>

          <!-- Add Listing -->
          <li class="nav-item mt-2 mt-lg-0 ms-lg-2">
            <a
              class="btn btn-primary"
              href="/listings/new">
              Add Listing
            </a>
          </li>

          <!-- Logout -->
          <li class="nav-item mt-2 mt-lg-0 ms-lg-2">
            <a
              class="btn btn-outline-danger"
              href="/logout">
              Logout
            </a>
          </li>

        <% } else { %>

          <!-- Login -->
          <li class="nav-item mt-2 mt-lg-0 ms-lg-2">
            <a
              class="btn btn-outline-primary"
              href="/login">
              Login
            </a>
          </li>

          <!-- Sign Up -->
          <li class="nav-item mt-2 mt-lg-0 ms-lg-2">
            <a
              class="btn btn-primary"
              href="/register">
              Sign Up
            </a>
          </li>

        <% } %>

      </ul>

    </div>
  </div>
</nav>